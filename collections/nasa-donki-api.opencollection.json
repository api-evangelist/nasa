                "type": "query"
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query"
              },
              {
                "name": "mostAccurateOnly",
                "value": "",
                "type": "query"
              },
              {
                "name": "speed",
                "value": "",
                "type": "query"
              },
              {
                "name": "halfAngle",
                "value": "",
                "type": "query"
              },
              {
                "name": "catalog",
                "value": "",
                "type": "query"
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns analysis data for coronal mass ejection events."
        },
