      "items": [
        {
          "info": {
            "name": "NASA Get coronal mass ejection events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.nasa.gov/DONKI/CME",
            "params": [
              {
                "name": "startDate",
                "value": "",
                "type": "query",
                "description": "Start date (YYYY-MM-DD). Defaults to 30 days prior."
              },
              {
                "name": "endDate",
                "value": "",
                "type": "query",
                "description": "End date (YYYY-MM-DD). Defaults to today."
              },
              {
                "name": "api_key",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns coronal mass ejection (CME) events within a date range."
        },
        {
          "info": {
            "name": "NASA Get CME analysis data",
            "type": "http"
