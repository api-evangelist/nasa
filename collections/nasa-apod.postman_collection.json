          "name": "NASA Get Astronomy Picture of the Day",
          "request": {
            "name": "NASA Get Astronomy Picture of the Day",
            "description": {
              "content": "Returns the astronomy picture of the day. Can retrieve a specific date, a date range, or random images.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "planetary",
                "apod"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "api_key",
                  "value": "DEMO_KEY",
                  "description": "(Required) API key for authentication. Use DEMO_KEY for testing."
                },
                {
                  "disabled": false,
                  "key": "date",
                  "value": "<date>",
                  "description": "The date of the APOD image to retrieve (YYYY-MM-DD)."
                },
                {
                  "disabled": false,
                  "key": "start_date",
                  "value": "<date>",
                  "description": "The start of a date range for multiple APOD images."
                },
                {
                  "disabled": false,
                  "key": "end_date",
                  "value": "<date>",
                  "description": "The end of a date range. Defaults to today."
                },
                {
                  "disabled": false,
                  "key": "count",
                  "value": "<integer>",
                  "description": "Return a specified number of random APOD images."
                },
                {
                  "disabled": false,
                  "key": "thumbs",
                  "value": "false",
                  "description": "Return URL of video thumbnail if media type is video."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
